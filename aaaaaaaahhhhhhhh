algoritmo "ah"
var
  no,pa:inteiro
inicio
  no <- 4
  escreval("numero?")
  leia(pa)
  enquanto no <> pa faca
    se (pa > no) entao
      escreval("muito alto")
    senao
      escreval("muito baixo")
    fimse
    escreval("numero?")
    leia(pa)
  fimenquanto
  escreval("certa resposta")
fimalgoritmo
